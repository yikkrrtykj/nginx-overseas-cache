[Unit]
Description=Overseas Cache Go WebSocket fanout
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=overseas-fanout
Group=overseas-fanout
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=3001
Environment=STATUS_FILE=/run/ws-fanout/status.json
EnvironmentFile=-/etc/nginx/overseas-cache/fanout-v2.env
ExecStart=/opt/overseas-cache-v2/bin/ws-fanout
RuntimeDirectory=ws-fanout
RuntimeDirectoryMode=0755
UMask=0022
Restart=on-failure
RestartSec=2
TimeoutStopSec=12
LimitNOFILE=16384
MemoryMax=1G
TasksMax=128
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
