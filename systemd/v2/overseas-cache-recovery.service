[Unit]
Description=Recover interrupted Overseas Cache deployment or configuration
After=network.target network-online.target
Before=nginx.service ws-fanout.service overseas-cache-admin.service
# Explicit repeated starts must always evaluate the current guard state.
StartLimitIntervalSec=0
ConditionPathExists=|/var/lib/overseas-cache-installer/pending-install
ConditionPathExists=|/etc/nginx/overseas-cache/backups/pending

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/lib/overseas-cache/install-admin.sh recover-before-start
TimeoutStartSec=150
