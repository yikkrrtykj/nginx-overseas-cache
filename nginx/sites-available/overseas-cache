server {
    listen 23333 default_server;
    listen [::]:23333 default_server;

    server_name _;

    server_tokens off;
    absolute_redirect off;
    keepalive_timeout 65;
    client_max_body_size 20m;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 4;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    add_header Referrer-Policy "no-referrer" always;

    # The renderer is an internal service and its URL contains a token. Reject
    # public source addresses even if a firewall rule is accidentally widened.
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 127.0.0.0/8;
    allow ::1/128;
    allow fc00::/7;
    allow fe80::/10;
    deny all;

    # This format deliberately omits paths, query strings and Referer values so
    # the channel token is not written to the normal access log.
    access_log /var/log/overseas-cache/traffic.log overseas_cache_safe;
    # Nginx error messages can include full token-bearing paths. Use the
    # route/status access log for data-plane failures.
    error_log /dev/null crit;

    # This file exists only on the server and contains channel/account/token.
    include /etc/nginx/overseas-cache/settings.conf;

    # Keep the browser on the local Nginx address.
    location = / {
        root /var/empty;
        try_files /.overseas-renderer-entry @overseas_renderer_entry;
    }
    location @overseas_renderer_entry {
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        return 302 "/render?rendererMode=onair&channelId=$render_channel&token=$render_token&accountId=$render_account";
    }

    # Cache fingerprinted JavaScript. This regex must be allowed to take
    # precedence over the ordinary /templates-auth/ prefix below.
    location ~* "^/templates-auth/[^/]+/[^/]+/(?:[^/]+/)*static/js/[^/]*[.-][a-f0-9]{8,}(?:\.chunk)?\.js$" {
        proxy_pass https://webcoder_origin;

        proxy_ssl_server_name on;
        proxy_ssl_name $overseas_origin_host;
        proxy_ssl_session_reuse on;

        proxy_set_header Host $overseas_origin_host;
        proxy_set_header Origin "https://$overseas_origin_host";
        proxy_set_header Referer "https://$overseas_origin_host/";

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_socket_keepalive on;

        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 16 64k;
        proxy_busy_buffers_size 128k;

        proxy_cache web_cache;
        proxy_cache_methods GET HEAD;
        # Including the real upstream hostname prevents old objects being
        # reused after scripts/change-upstreams.sh switches to another domain.
        proxy_cache_key "v2|origin|$overseas_origin_host|$request_uri";
        proxy_cache_bypass $overseas_skip_cache;
        proxy_no_cache $overseas_skip_cache;

        proxy_hide_header Set-Cookie;

        proxy_cache_valid 200 1d;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_revalidate on;
        proxy_cache_background_update on;
        proxy_cache_use_stale error timeout invalid_header updating
                              http_500 http_502 http_503 http_504;

        add_header Referrer-Policy "no-referrer" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # CDN-hosted templates, images, fonts and media.
    location ^~ /templates/ {
        proxy_pass https://webcoder_cdn;

        proxy_ssl_server_name on;
        proxy_ssl_name $overseas_cdn_host;
        proxy_ssl_session_reuse on;

        proxy_set_header Host $overseas_cdn_host;
        proxy_set_header Origin "https://$overseas_origin_host";
        proxy_set_header Referer "https://$overseas_origin_host/";

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_socket_keepalive on;

        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 16 64k;
        proxy_busy_buffers_size 128k;

        # Address rewriting requires an uncompressed upstream response.
        proxy_set_header Accept-Encoding "";

        sub_filter_once off;
        sub_filter_types text/css text/javascript application/javascript
                         application/json application/manifest+json;
        sub_filter "https://$overseas_origin_host" 'http://$http_host';
        sub_filter "https://$overseas_cdn_host" 'http://$http_host';
        sub_filter "wss://$overseas_origin_host" 'ws://$http_host';

        proxy_redirect "https://$overseas_cdn_host/" http://$http_host/;

        proxy_cache web_cache;
        proxy_cache_methods GET HEAD;
        proxy_cache_key "v2|cdn|$overseas_cdn_host|$request_uri";
        proxy_cache_bypass $overseas_skip_cache;
        proxy_no_cache $overseas_skip_cache;
        proxy_hide_header Set-Cookie;

        proxy_cache_valid 200 1d;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_revalidate on;
        proxy_cache_background_update on;
        proxy_cache_use_stale error timeout invalid_header updating
                              http_500 http_502 http_503 http_504;

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Methods
                   "GET, POST, OPTIONS, PUT, DELETE" always;
        add_header Access-Control-Allow-Headers
                   "Origin, X-Requested-With, Content-Type, Accept, Authorization, Range"
                   always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header Accept-Ranges bytes always;
    }

    # Authenticated template documents and non-fingerprinted assets remain
    # dynamic. Do not add ^~ here; the static-JS regex above must still match.
    location /templates-auth/ {
        proxy_pass https://webcoder_origin;

        proxy_ssl_server_name on;
        proxy_ssl_name $overseas_origin_host;
        proxy_ssl_session_reuse on;

        proxy_set_header Host $overseas_origin_host;
        proxy_set_header Origin "https://$overseas_origin_host";
        proxy_set_header Referer "https://$overseas_origin_host/";

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_socket_keepalive on;

        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_cache off;
        proxy_buffering off;

        proxy_redirect "https://$overseas_origin_host/" http://$http_host/;
        proxy_redirect "http://$overseas_origin_host/" http://$http_host/;

        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter_types text/css text/javascript application/javascript
                         application/json application/manifest+json;
        sub_filter "https://$overseas_origin_host" 'http://$http_host';
        sub_filter "https://$overseas_cdn_host" 'http://$http_host';
        sub_filter "wss://$overseas_origin_host" 'ws://$http_host';

        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Content-Security-Policy-Report-Only;

        proxy_cookie_domain ~^.*$ $host;
        proxy_cookie_flags ~ nosecure samesite=lax;
    }

    # All LAN browsers connect here, while the local fanout relay maintains
    # only one overseas WebSocket for each origin/token/channel/mode group.
    # Query parameters, including the token, are preserved by proxy_pass.
    location = /ws {
        if ($overseas_ws_origin_allowed = 0) { return 403; }

        proxy_pass http://127.0.0.1:3001;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # These headers are always overwritten by Nginx. The loopback-only
        # relay validates them before opening an upstream connection, so a
        # browser cannot select an arbitrary destination.
        proxy_set_header X-Fanout-Upstream-Base "wss://$overseas_origin_host/ws";
        proxy_set_header X-Fanout-Upstream-Origin "https://$overseas_origin_host";

        proxy_cache off;
        proxy_buffering off;

        proxy_connect_timeout 10s;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Main documents and APIs. Live traffic is never cached.
    location / {
        proxy_pass https://webcoder_origin;

        proxy_ssl_server_name on;
        proxy_ssl_name $overseas_origin_host;
        proxy_ssl_session_reuse on;

        proxy_set_header Host $overseas_origin_host;
        proxy_set_header Origin "https://$overseas_origin_host";
        proxy_set_header Referer "https://$overseas_origin_host/";

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_socket_keepalive on;

        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_cache off;
        proxy_buffering off;

        proxy_redirect "https://$overseas_origin_host/" http://$http_host/;
        proxy_redirect "http://$overseas_origin_host/" http://$http_host/;

        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter_types text/css text/javascript application/javascript
                         application/json application/manifest+json;
        sub_filter "https://$overseas_origin_host" 'http://$http_host';
        sub_filter "https://$overseas_cdn_host" 'http://$http_host';
        sub_filter "wss://$overseas_origin_host" 'ws://$http_host';

        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Content-Security-Policy-Report-Only;

        proxy_cookie_domain ~^.*$ $host;
        proxy_cookie_flags ~ nosecure samesite=lax;
    }
}

# Management liveness for the local operator console.
server {
    listen 127.0.0.1:23334;
    server_name localhost;
    access_log off;
    server_tokens off;
    location = /healthz { return 204; }
    location / { return 404; }
}
